# CurseForge API key: https://console.curseforge.com
# The key contains $ — wrap it in SINGLE quotes: CURSEFORGE_API_KEY='$2a$10$...'
CURSEFORGE_API_KEY=
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Channel (@channel_name or -100…) or chat; the bot must be an admin of the channel
TELEGRAM_CHAT_ID=
# Comma-separated Telegram user ids the bot answers commands from in private chat; empty disables commands
TELEGRAM_ADMIN_IDS=
# Which versions to announce: retail, classic, forever, comma-separated; empty means all
FLAVORS=
# Seconds between checks
POLL_INTERVAL=600
# Database path (overridden to /data/bot.db in Docker)
DB_PATH=data/bot.db
